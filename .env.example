# Copy this file to .env.local and fill in values. Never commit .env.local.

# Public site URL (used for invite links, email redirects, promo links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2) — from Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=en
